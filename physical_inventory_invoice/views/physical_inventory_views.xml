<odoo>
    <record id="view_physical_inventory_session_list" model="ir.ui.view">
        <field name="name">physical.inventory.session.list</field>
        <field name="model">physical.inventory.session</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="date"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="location_id"/>
                <field name="partner_id"/>
                <field name="invoice_id"/>
                <field name="state" widget="badge" decoration-success="state == 'done'"/>
            </list>
        </field>
    </record>

    <record id="view_physical_inventory_session_form" model="ir.ui.view">
        <field name="name">physical.inventory.session.form</field>
        <field name="model">physical.inventory.session</field>
        <field name="arch" type="xml">
            <form string="Physical Inventory Count">
                <header>
                    <button name="action_create_invoice_and_apply" type="object"
                            string="Create Invoice" class="btn-primary"
                            invisible="state != 'draft'"
                            groups="account.group_account_invoice"
                            confirm="This will create the customer invoice and adjust stock. Continue?"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,done"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="date" readonly="state == 'done'"/>
                            <field name="company_id" readonly="state == 'done'" groups="base.group_multi_company"/>
                            <field name="location_id" readonly="state == 'done' or line_ids"/>
                        </group>
                        <group>
                            <field name="partner_id" readonly="state == 'done'"/>
                            <field name="invoice_id" invisible="not invoice_id"/>
                        </group>
                    </group>
                    <group string="Barcode Scanning" invisible="state != 'draft'">
                        <field name="barcode_input" placeholder="Scan barcode and press Enter..."/>
                    </group>
                    <notebook>
                        <page string="Counted Products">
                            <field name="line_ids" readonly="state == 'done'">
                                <list editable="bottom">
                                    <field name="session_id" column_invisible="1"/>
                                    <field name="product_id" readonly="id" force_save="1"
                                           options="{'no_create': True, 'no_open': True}"/>
                                    <field name="barcode" optional="show"/>
                                    <field name="uom_id" optional="hide"/>
                                    <field name="existing_qty"/>
                                    <field name="counted_qty"
                                           decoration-danger="counted_qty &lt; existing_qty"
                                           decoration-success="counted_qty &gt; existing_qty"/>
                                    <field name="shortage_qty"/>
                                    <field name="unit_price"/>
                                    <field name="subtotal" sum="Total"/>
                                    <field name="currency_id" column_invisible="1"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_physical_inventory_session" model="ir.actions.act_window">
        <field name="name">Inventory Counts</field>
        <field name="res_model">physical.inventory.session</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_physical_inventory_session"
              name="Inventory Counts"
              parent="stock.menu_stock_inventory_control"
              action="action_physical_inventory_session"
              sequence="50"
              groups="stock.group_stock_user"/>
</odoo>